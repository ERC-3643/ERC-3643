#### Transfer Flow (Internal)

```solidity
function _transfer(address from, address to, uint256 amount) internal
```

**Validation Steps**:
1.  Check token not paused
2.  Check sender not frozen
3.  Check receiver not frozen
4.  Check sufficient unfrozen balance
5.  Verify receiver identity: `identityRegistry.isVerified(to)`
6.  Check compliance: `compliance.canTransfer(from, to, amount)`
7.  Execute balance updates
8.  Notify compliance: `compliance.transferred(from, to, amount)`

**Code Flow**:
```solidity
function _transfer(address _from, address _to, uint256 _amount) internal {
    require(!_tokenPaused, "Pausable: paused");
    require(!_frozen[_from], "wallet is frozen");
    require(!_frozen[_to], "wallet is frozen");
    require(
        _balances[_from] - _frozenTokens[_from] >= _amount,
        "Insufficient Balance"
    );
    
    if (_tokenIdentityRegistry.isVerified(_to)) {
        require(
            _tokenCompliance.canTransfer(_from, _to, _amount),
            "Transfer not compliant"
        );
        
        _balances[_from] -= _amount;
        _balances[_to] += _amount;
        
        _tokenCompliance.transferred(_from, _to, _amount);
        emit Transfer(_from, _to, _amount);
    } else {
        revert("Transfer not possible");
    }
}
```

